  OBJECT_DIR = CMakeFiles\openppp2.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  SONAME = libopenppp2.so
  SONAME_FLAG = -Wl,-soname,
  TARGET_FILE = D:\github\openppp2\bin\android\arm64-v8a\libopenppp2.so
  TARGET_PDB = openppp2.so.dbg
  RSP_FILE = CMakeFiles\openppp2.rsp


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cmd.exe /C "cd /D D:\github\openppp2\android\build_arm64 && D:\github\openppp2\.toolchains\android-sdk\cmake\3.22.1\bin\cmake.exe -E echo "No interactive CMake dialog available.""
  DESC = No interactive CMake dialog available...
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cmd.exe /C "cd /D D:\github\openppp2\android\build_arm64 && D:\github\openppp2\.toolchains\android-sdk\cmake\3.22.1\bin\cmake.exe --regenerate-during-build -SD:\github\openppp2\android -BD:\github\openppp2\android\build_arm64"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

# =============================================================================
# Target aliases.

build libopenppp2.so: phony D$:/github/openppp2/bin/android/arm64-v8a/libopenppp2.so

build openppp2: phony D$:/github/openppp2/bin/android/arm64-v8a/libopenppp2.so

